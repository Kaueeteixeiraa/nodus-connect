rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    match /users/{userId}/{document=**} {
      allow read, write: if signedIn() && request.auth.uid == userId;
    }

    match /devices/{nodusId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.nodusId == nodusId
        && request.resource.data.ownerUid == request.auth.uid
        && ((!('deviceId' in request.resource.data) && !('deviceFingerprint' in request.resource.data))
          || (get(/databases/$(database)/documents/deviceClaims/$(nodusId)).data.ownerUid == request.auth.uid
            && request.resource.data.deviceId is string
            && request.resource.data.deviceFingerprint is string));
      allow update: if signedIn()
        && request.resource.data.nodusId == nodusId
        && request.resource.data.ownerUid == request.auth.uid
        && ((resource.data.ownerUid == request.auth.uid
            && !('deviceId' in resource.data)
            && !('deviceFingerprint' in resource.data))
          || (get(/databases/$(database)/documents/deviceClaims/$(nodusId)).data.ownerUid == request.auth.uid
            && request.resource.data.deviceId is string
            && request.resource.data.deviceFingerprint is string
            && (!('deviceId' in resource.data) || request.resource.data.deviceId == resource.data.deviceId)
            && (!('deviceFingerprint' in resource.data) || request.resource.data.deviceFingerprint == resource.data.deviceFingerprint)));
    }

    match /deviceClaims/{nodusId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.nodusId == nodusId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.deviceClaim is string
        && (!exists(/databases/$(database)/documents/devices/$(nodusId))
          || !('deviceId' in get(/databases/$(database)/documents/devices/$(nodusId)).data)
          || !('deviceFingerprint' in get(/databases/$(database)/documents/devices/$(nodusId)).data)
          || (request.resource.data.deviceId == get(/databases/$(database)/documents/devices/$(nodusId)).data.deviceId
            && request.resource.data.deviceFingerprint == get(/databases/$(database)/documents/devices/$(nodusId)).data.deviceFingerprint));
      allow update: if signedIn()
        && request.resource.data.nodusId == nodusId
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.deviceClaim == resource.data.deviceClaim
        && request.resource.data.deviceId == resource.data.deviceId
        && request.resource.data.deviceFingerprint == resource.data.deviceFingerprint;
    }

    match /sessionRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.targetUid ==
          get(/databases/$(database)/documents/devices/$(request.resource.data.targetNodusId)).data.ownerUid
        && request.resource.data.status == 'pending';
      allow read: if signedIn() && resource.data.requesterUid == request.auth.uid;
      allow read: if signedIn() && resource.data.targetUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.targetUid == request.auth.uid
        && request.resource.data.requesterUid == resource.data.requesterUid
        && request.resource.data.targetUid == resource.data.targetUid
        && request.resource.data.requesterNodusId == resource.data.requesterNodusId
        && request.resource.data.targetNodusId == resource.data.targetNodusId
        && request.resource.data.status in ['accepted', 'denied'];
    }

    match /sessions/{sessionId} {
      allow read: if signedIn()
        && request.auth.uid in resource.data.participantUids;
      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participantUids;
      allow update: if signedIn()
        && request.auth.uid in resource.data.participantUids
        && request.resource.data.participantUids == resource.data.participantUids;

      match /signals/{to}/items/{signalId} {
        allow read, write: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/sessions/$(sessionId)).data.participantUids;
      }
    }
  }
}
